# Never commit the real Odds API key.
ODDS_API_KEY=

# NWS asks applications to identify themselves.
NWS_USER_AGENT=AITA-NFL-SCORER/0.3.0a1 (contact: replace-with-email@example.com)

# Public fantasy/projection sites are accessed only through ordinary public pages.
# Use a real contact address. The pipeline does not bypass login/paywall/CAPTCHA controls.
PUBLIC_FANTASY_USER_AGENT=AITA-NFL-SCORER/0.3.0a1 (contact: replace-with-email@example.com)

# Optional Yahoo Fantasy corroboration layer. Yahoo is NOT required in v0.3.
# Leave blank unless you intentionally want the OAuth-backed Yahoo league context too.
YAHOO_FANTASY_ACCESS_TOKEN=
YAHOO_FANTASY_LEAGUE_KEY=
